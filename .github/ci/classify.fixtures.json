{
  "schema": 1,
  "comment": "Classifier fixture rows for the docs-repo shape (skill, prompt, docs and shell repos). Run: node .github/ci/classify.mjs --test. This shape has no e2e or deps job, so those flags stay false.",
  "tracked": [
    ".github/ci-setup.json",
    ".github/ci/classify.json",
    ".github/workflows/ci.yml",
    "AGENTS.md",
    "README.md",
    "mise.toml",
    "skills/demo/SKILL.md",
    "skills/demo/references/guide.md",
    "skills/demo/scripts/run.sh"
  ],
  "protected_paths": [
    "/.github/", "/mise.toml", "/mise.lock", "/AGENTS.md", "/CLAUDE.md", "/.claude/", "/.codex/",
    "/mise.*.toml", "/.mise.toml", "/.mise.*.toml", "/mise.*.lock", "/.mise/", "/mise/",
    "/.config/mise.toml", "/.config/mise.*.toml", "/.config/mise/", "/mise-tasks/", "/.mise-tasks/",
    "/.tool-versions", "/.gitleaks.toml", "/.gitleaksignore", "/.gitignore",
    "biome.json*", "tsconfig*.json", "vitest.config.*", "playwright.config.*",
    "eslint.config.*", ".eslintrc*", "jest.config.*", "vite.config.*",
    ".markdownlint*", ".markdownlint-cli2.*", ".shellcheckrc", ".editorconfig",
    "ruff.toml", "pytest.ini", "mypy.ini", "clippy.toml", "rustfmt.toml", "deny.toml",
    "rust-toolchain.toml"
  ],
  "rows": [
    {"id": "ignored-test-output", "name": "test and coverage output under reports/, test-results/, playwright-report/ and coverage/ sets no flag",
     "paths": ["reports/unit.xml", "test-results/run/trace.zip", "playwright-report/index.html", "coverage/lcov.info"],
     "expect": {"code": false, "e2e": false, "docs": false, "workflows": false, "deps": false}},
    {"id": "empty-diff", "name": "empty diff fails open",
     "paths": [],
     "expect": {"code": true, "docs": true, "workflows": true}},
    {"id": "docs-only", "name": "docs-only change",
     "paths": ["README.md", "docs/notes.md"],
     "expect": {"code": false, "docs": true, "workflows": false}},
    {"id": "workflow-only", "name": "workflow-only change sets every flag (always_all)",
     "paths": [".github/workflows/ci.yml"],
     "expect": {"code": true, "docs": true, "workflows": true}},
    {"id": "lockfile-only", "name": "mise.lock only sets every flag (always_all)",
     "paths": ["mise.lock"],
     "expect": {"code": true, "docs": true, "workflows": true}},
    {"id": "mixed", "name": "skill and shell change",
     "paths": ["skills/demo/SKILL.md", "skills/demo/scripts/run.sh"],
     "expect": {"code": true, "docs": true, "workflows": false}},
    {"id": "rename", "name": "rename counts as a delete plus an add",
     "paths": ["skills/old/SKILL.md", "skills/new/SKILL.md"],
     "expect": {"code": true, "docs": true, "workflows": false}},
    {"id": "deep-path", "name": "deep path in a skill's references",
     "paths": ["skills/demo/references/a/b/c/deep.md"],
     "expect": {"code": true, "docs": true, "workflows": false}},
    {"id": "skill-linked-file", "name": "a file under .agents/skills that SKILL.md links to runs the skill lint",
     "paths": [".agents/skills/verify-course-keeper/features/desktop.md"],
     "expect": {"code": true, "docs": true, "workflows": false}},
    {"id": "skill-journey-script", "name": "a journey script under .agents/skills sets code only",
     "paths": [".agents/skills/verify-course-keeper/journeys/desktop"],
     "expect": {"code": true, "docs": false, "workflows": false}},
    {"id": "dotfile", "name": "dotfile shell script matches **/*.sh",
     "paths": ["bin/.helper.sh"],
     "expect": {"code": true, "docs": false, "workflows": false}},
    {"id": "unknown-path", "name": "unknown path fails open",
     "paths": ["images/diagram.png"],
     "expect": {"code": true, "docs": true, "workflows": true}},
    {"id": "declared-no-files", "name": "Declared stack docs with no skill or shell files: requires forces code false",
     "mode": "all",
     "tracked": ["README.md", ".github/workflows/ci.yml", "mise.toml"],
     "expect": {"code": false, "docs": true, "workflows": true}},
    {"id": "drift-cargo", "name": "Cargo.toml in a repo with no Rust job: drift warning, exit 0",
     "mode": "languages",
     "tracked": ["README.md", "Cargo.toml"],
     "expect_warnings": ["rust"]},
    {"id": "drift-typescript", "name": "package.json in a docs repo: typescript warning",
     "mode": "languages",
     "tracked": ["README.md", "package.json"],
     "expect_warnings": ["typescript"]},
    {"id": "drift-acknowledged", "name": "acknowledged uncovered language: no warning",
     "mode": "languages",
     "tracked": ["README.md", "Cargo.toml"],
     "acknowledged": ["rust"],
     "expect_warnings": []},
    {"id": "protected-agents-md", "name": "--protected with a changed AGENTS.md: one notice, exit 0",
     "mode": "protected",
     "paths": ["AGENTS.md"],
     "expect_notices": ["AGENTS.md"]},
    {"id": "protected-biome", "name": "--protected with a changed biome.json: one notice",
     "mode": "protected",
     "paths": ["biome.json", "README.md"],
     "expect_notices": ["biome.json"]},
    {"id": "base-push", "name": "base output is empty on push (--all)",
     "mode": "all",
     "expect_output": {"base": ""}},
    {"id": "base-pr", "name": "base output is set on a pull request",
     "paths": ["README.md"],
     "base": "89abcdef0123456789abcdef0123456789abcdef",
     "expect_output": {"base": "89abcdef0123456789abcdef0123456789abcdef", "docs": "true", "e2e": "false", "deps": "false"}}
  ]
}
