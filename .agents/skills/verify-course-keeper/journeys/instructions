    record = run.wait_store(lambda r: Y in r["instructions"], "the reply's other instruction "
                            "is added", save="store-8b")
    expect(record["instructions"] == [I12, I6, Y],
           "an instruction withdrawn during its extract call is not added back (the store)",
           [I12, I6, Y], json.dumps(record["instructions"]))
    expect(record["withdrawn"] == [I1],
           "an instruction withdrawn during its extract call stays withdrawn, once, after it "
           "was withdrawn, stated again and withdrawn again (the store)", [I1],
           json.dumps(record["withdrawn"]))
    view = run.command("", "Last check:", "status-8b")
    expect(f"3. {Y}" in flat(view), "status keeps an instruction of more than 80 characters "
           "whole", f"3. {Y}", view)
    listed(view, I12, I6, Y)
    withdrawn = f"Withdrawn standing instructions: - {I1} Alerts in this session:"
    expect(withdrawn in flat(view), "status lists the instruction withdrawn twice once, as "
           "withdrawn", withdrawn, view)

    step("11 an active instruction stated again")
    script_turn(run, P13, A13, H13)
    record, _, check = silent_turn(run, P13, A13, last_check_at(run), "turn-13",
                                   "stating an active instruction again shows no added notice")
    expect(record["instructions"] == [I12, I6, Y] and record["withdrawn"] == [I1],
           "stating an active instruction again adds no duplicate", [I12, I6, Y],
           json.dumps(record["instructions"]))
    held = section(check["last_user"], INSTRUCTIONS_HEADING, ALERTS_HEADING).strip()
    want = f"1. {I12}\n2. {I6}\n3. {Y}\n\n{WITHDRAWN_HEADING}\n- {I1}"
    expect(held == want, "the next check holds the instruction withdrawn twice once, as "
           "withdrawn, and the instruction of more than 80 characters whole", want, held)
    view = run.command("", "Last check:", "status-13")
    listed(view, I12, I6, Y)

    step("12 a reply of four instruction lines to a prompt of more than 60 characters")
    script_turn(run, P14, A14, "\n".join(f"- {text}" for text in FOUR))
    mark, at = run.last_seq(), last_check_at(run)
    run.send(P14)
    ex = run.wait_request(lambda r: r["seq"] > mark and is_extract(r),
                          "the prompt of more than 60 characters starts an extract call")
    expect(message_in(ex) == P14, f"the extract call's message is the whole prompt "
           f"({len(P14)} characters)", P14, message_in(ex))
    noted(run, notice(*FOUR[:3]), "toast-14",
          "a four-line extract reply adds only its first three lines (the notice counts 3)")
    run.wait("⏺ " + A14, timeout=45, after="❯ " + P14, save="turn-14")
    record, _ = wait_check(run, at, "verdict: none", "store-14-check")
    active = [I12, I6, Y, *FOUR[:3]]
    expect(record["instructions"] == active,
           "a four-line extract reply adds only its first three lines (the store)",
           active, json.dumps(record["instructions"]))
    view = run.command("", "Last check:", "status-14")
    listed(view, *active)

    step("10 /compact asks the summarizer to keep the standing instructions")
    run.reply(COMPACT_ASK, SUMMARY, times=1)
    mark = run.last_seq()
    run.send("/compact")
    run.wait("Compacted", timeout=60, after="❯ /compact", save="compact")
    asks = [r for r in run.requests() if r["seq"] > mark and is_messages(r)
            and COMPACT_ASK in r["last_user"]]
    want = COMPACT_REQUEST + "".join(f"\n{i + 1}. {t}" for i, t in enumerate(active))
    expect(len(asks) == 1 and want in asks[0]["last_user"],
           "the summary request asks to keep the standing instructions", want,
           json.dumps([r["last_user"][-800:] for r in asks]))
    # Host fact, not a plugin promise: Claude Code 2.1.332 fires no prompt.submit for /compact
    # (with every shouldExtract guard removed, /compact still started no extract call and did
    # not set hasPerson).
    expect(not extracts(run, mark), "Claude Code passes /compact to no prompt hook (no "
           "extract call)", "none", "some")
    view = run.command("", "Last check:", "status-10")
    listed(view, *active)
    run.store(save="store-10")
    expect(vision_file.read_text() == vision, "the plugin leaves VISION.md unchanged", vision,
           "changed")

    step("10a /compact with focus text keeps the focus text and adds the standing instructions")
    run.reply(COMPACT_ASK, SUMMARY, times=1)
    mark = run.last_seq()
    run.send("/compact " + FOCUS)
    run.wait("Compacted", timeout=60, after="❯ /compact " + FOCUS, save="compact-10a")
    asks = [r for r in run.requests() if r["seq"] > mark and is_messages(r)
            and COMPACT_ASK in r["last_user"]]
    # compactInstructions: the summarizer's existing instructions (the focus text), an empty
    # line, then the plugin's request.
    want = FOCUS + "\n\n" + COMPACT_REQUEST + "".join(f"\n{i + 1}. {t}"
                                                       for i, t in enumerate(active))
    expect(len(asks) == 1 and want in asks[0]["last_user"],
           "the summary request of /compact <focus> carries the focus text and then the "
           "standing instructions", want, json.dumps([r["last_user"][-900:] for r in asks]))
    view = run.command("", "Last check:", "status-10a")
    listed(view, *active)

    step("10b /compact after the person deleted VISION.md")
    vision_file.unlink()  # fixture state, as a person would delete the file
    view = run.command("", NO_VISION_STATUS, "status-10b")
    listed(view, *active)
    # After two compactions Claude Code answers a third /compact with "Not enough messages to
    # compact." until a new turn: the person works on.
    script_turn(run, P10, A10, None, check=None)
    at = last_check_at(run)
    ask(run, P10, A10, "turn-10b")
    wait_check(run, at, "did not run: no VISION.md found", "store-10b-turn")
    run.reply(COMPACT_ASK, SUMMARY_2, times=1)
    mark = run.last_seq()
    run.send("/compact")
    run.wait("Compacted", timeout=60, after="❯ /compact", save="compact-10b")
    asks = [r for r in run.requests() if r["seq"] > mark and is_messages(r)
            and COMPACT_ASK in r["last_user"]]
    expect(len(asks) == 1, "one summary request for the /compact without a vision file", 1,
           json.dumps([r["seq"] for r in asks]))
    # The summarizer's own instructions start at COMPACT_ASK; the plugin's text would follow
    # them (step 10). The earlier part of the message holds merged slash command echoes.
    told = asks[0]["last_user"][asks[0]["last_user"].find(COMPACT_ASK):]
    carried = [t for t in (COMPACT_REQUEST, *active) if t in told]
    expect(not carried, "without a vision file the summary request carries no standing "
           "instruction", "none of the instruction texts", carried)

    step("evidence")
    run.requests(save="model-requests")
    for prompt, what in ((P0, "a prompt whose trimmed text starts with '/'"),
                         (P11, f"a prompt of {len(P11.strip())} characters after trimming")):
        late = [r["seq"] for r in run.requests() if is_messages(r) and prompt in r["last_user"]
                and (is_extract(r) or "haiku" in (r["model"] or ""))]
        expect(not late, f"{what} started no extract call up to the end of the run", "none",
               json.dumps(late))
    unscripted(run)

    step("9 no vision")
    with second_run("--no-vision", parent=run, label="no-vision") as other:
        project = Path(other.dir, "scratch/project")
        script_turn(other, P9, A9, None, check=None)
        ask(other, P9, A9, "turn-9")
        record, seen = wait_check(other, 0, "did not run: no VISION.md found", "store-9",
                                  watch=TOAST_PREFIX)
        requests = other.requests(save="model-requests")
        marked = [(r["seq"], r["model"]) for r in requests if is_messages(r) and (
            "haiku" in (r["model"] or "") or carries(r, "extract") or carries(r, "check"))]
        expect(not marked, "no extract request in a project without a vision (and no check)",
               "none", json.dumps(marked))
        expect(not seen, "no added notice without a vision", "none", seen)
        expect(record["instructions"] == [], "nothing recorded without a vision", [],
               record["instructions"])
        view = other.command("", "Last check:", "status-9")
        for text in (NO_VISION_STATUS, "Standing instructions: none",
                     "did not run: no VISION.md found."):
            expect(has(view, text), f"no-vision status {text!r}", text, view)
        unscripted(other)
        made = [name for name in ("VISION.md", "ANTI-PATTERNS.md") if (project / name).exists()]
        expect(not made, "the plugin writes no vision file into the project", "none", made)


