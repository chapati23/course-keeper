def extract_prompt(message):
    """prompts/extract.md as the plugin sends it: every leading HTML comment removed
    (stripLeadingComments) and {{message}} filled (fillExtractPrompt)."""
    text = EXTRACT_FILE.read_text()
    while True:
        out = re.sub(r"^\s*<!--[\s\S]*?-->[ \t]*\r?\n?", "", text, count=1)
        out = re.sub(r"^\s+", "", out, count=1)
        if out == text:
            break
        text = out
    return text.replace("{{message}}", message)


def listed(view, *texts):
    """The status lists exactly these active instructions, numbered from 1."""
    want = "Standing instructions: " + " ".join(f"{i + 1}. {t}" for i, t in enumerate(texts))
    following = "Withdrawn standing instructions:" if "Withdrawn standing" in view \
        else "Alerts in this session:"
    expect(f"{want} {following}" in flat(view), "status lists the standing instructions",
           f"{want} {following}", view)


def shows(toast, want, least=None):
    """True when a toast shows the notice `want`: whole, or cut at its end with "…" (Claude
    Code cuts a toast to three lines of 40 columns) after at least `least` characters of
    `want` (default: the head and the whole first quoted instruction). The frames that
    slide in are cut on every line, so they hold "…" before the end and count as not
    showing it."""
    body = toast[toast.find(TOAST_PREFIX):]
    want = flat(want)
    if want in body:
        return True
    if least is None:
        least = len(want.split('"; ')[0]) + 1
    return (body.endswith("…") and body.count("…") == 1
            and len(body) - 1 >= least and want.startswith(body[:-1]))


def noted(run, want, label, what, timeout=20, least=None):
    """Polls the visible pane for a toast of the added-notice family, follows it until it
    goes, and asserts that one of its frames shows `want` (see shows). Saves the first
    such frame as <label>.txt. Returns the seconds the toast stayed."""
    deadline = time.monotonic() + timeout
    while True:
        view = run.screen(visible=True)
        held = [t for t in toasts(view) if TOAST_PREFIX in t]
        if held:
            first = time.monotonic()
            break
        if time.monotonic() >= deadline:
            Path(run.evidence, label + "-timeout.txt").write_text(view)
            raise JourneyFailure(what, f"a toast that holds {want!r}",
                                 f"no toast within {timeout}s; toasts seen last: {toasts(view)}")
        time.sleep(0.1)
    seen, saved = list(held), False
    while held:
        if not saved and any(shows(t, want, least) for t in held):
            Path(run.evidence, label + ".txt").write_text(view)
            saved = True
        if time.monotonic() >= first + timeout:
            raise JourneyFailure("the added notice goes", f"no toast {timeout}s after it showed",
                                 seen[-1])
        time.sleep(0.15)
        view = run.screen(visible=True)
        held = [t for t in toasts(view) if TOAST_PREFIX in t]
        seen += held
    if not saved:
        Path(run.evidence, label + "-frames.txt").write_text("\n".join(dict.fromkeys(seen)))
    expect(saved, what, want, list(dict.fromkeys(seen)))
    return round(time.monotonic() - first, 1)


def silent_turn(run, prompt, answer, at, label, what):
    """The person types `prompt`; the agent answers; the turn's check ends with 'verdict:
    none'. While all that runs, no added notice may show. The watch ends when the store
    records the check, and it covers the extract reply only when the extract request was
    logged before the check request (the endpoint answers it at once): that is asserted."""
    mark = run.last_seq()
    ask(run, prompt, answer, label)
    record, seen = wait_check(run, at, "verdict: none", "store-" + label, watch=TOAST_PREFIX)
    expect(not seen, what, "no toast while the turn and its check ran", seen)
    ex = extracts(run, mark)
    checks = [r for r in run.requests() if r["seq"] > mark and is_check(r)]
    expect(len(ex) == 1 and message_in(ex[0]) == prompt and checks
           and ex[0]["seq"] < checks[0]["seq"],
           "the no-notice watch covers the extract reply: one extract call for the prompt, "
           "logged before the turn's check", f"extract of {prompt!r} before check",
           json.dumps({"extracts": [(r["seq"], message_in(r)) for r in ex],
                       "checks": [r["seq"] for r in checks]}))
    return record, ex[0], checks[0]


def no_extract_turn(run, prompt, answer, label, what, person=None):
    """The person types `prompt`; the agent answers; the turn's check ends. Asserts that no
    extract call and no haiku call was logged up to then. The final step of the journey
    repeats the assertion over the whole request log. With person (a promise), first waits
    for the store's hasPerson, failing on that promise: no check runs without it."""
    script_turn(run, prompt, answer, None)
    mark, at = run.last_seq(), last_check_at(run)
    ask(run, prompt, answer, label)
    if person:
        run.wait_store(lambda r: r.get("hasPerson") is True, person, save="store-person-" + label)
    record, _ = wait_check(run, at, "verdict: none", "store-" + label)
    late = [(r["seq"], r["model"], message_in(r)) for r in run.requests() if r["seq"] > mark
            and is_messages(r) and (is_extract(r) or "haiku" in (r["model"] or ""))]
    expect(not late, what, "no extract or haiku request until the turn's check ended",
           json.dumps(late))
    return record


