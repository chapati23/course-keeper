        run.screen(visible=True, save="details-open-text")
        label = run.press("details", "press details finds the Hide details Button")
        expect(label == "Hide details", "the second press presses Hide details", "Hide details",
               label)
        run.wait_store(lambda r: r.get("showDetails") is False and r["current"] is not None,
                       "a second press of Details closes the parts (showDetails false) and keeps "
                       "the alert open", save="store-details-closed")
        tree = poll_tree(run, lambda t: not any(e["text"].startswith("For the agent: ")
                                                for e in elements(t)),
                         "a second press of Details removes the parts from the tree",
                         "no 'For the agent:' part", save="details-closed")
        card_closed_parts(tree, ALERT_1, HEADLINE_1)

        step(f"{next(n)} Tell the agent: the store records the answer, the tree is empty, the "
             "next main request carries the note")
        run.reply(note_text(ALERT_1), AGENT_NOTE, times=1)
        run.reply(final(AGENT_NOTE), "verdict: none", times=1)
        mark = run.last_seq()
        label = run.press("Tell the agent", "press finds the Tell the agent Button")
        expect(label == "Tell the agent", "press presses Tell the agent", "Tell the agent", label)
        record = run.wait_store(lambda r: answer_of(r, ALERT_1) is not None,
                                "Tell the agent answers alert 1", save="store-told")
        expect(answer_of(record, ALERT_1) == "told the agent",
               "Tell the agent records 'told the agent'", "told the agent",
               answer_of(record, ALERT_1))
        card_gone(run, "after Tell the agent the tree is empty (the card closes)", "told-closed")
        sent = run.wait_request(lambda r: r["seq"] > mark and is_main(r),
                                "Tell the agent sends the note as the next main request")
        framed = FRAMED + " " + note_text(ALERT_1)
        expect(framed in flat(sent["last_user"]), "the next main request carries the note as a "
               "message from the plugin", framed, sent["last_user"][:2000])
        run.expect_wait("▸ Prompt from the course-keeper plugin: " + FRAMED,
                        "the CLI echoes the note as a prompt from the course-keeper plugin "
                        "(the session transcript's origin)", timeout=15, save="told-prompt")
        run.expect_wait("⏺ " + AGENT_NOTE, "the agent answers the plugin's note",
                        after="▸ Prompt from the course-keeper plugin", timeout=30,
                        save="told-reply")
        run.wait_store(lambda r: r["lastCheck"]["outcome"] == "verdict: none" and
                       r.get("checkingSince") is None, "the plugin's turn is checked", timeout=30)
        noted = [r["seq"] for r in run.requests() if r["seq"] > mark and "haiku" in (r["model"] or "")]
        expect(not noted, "the plugin's note starts no haiku call", "none", json.dumps(noted))

        step(f"{next(n)} False alarm: one press relabels the Button 'Confirm false alarm'; the "
             "second records the false alarm")
        alert_turn(run, PROMPT_2, AGENT_2, ALERT_2, "turn-2")
        label = run.press("False alarm", "press finds the False alarm Button")
        expect(label == "False alarm", "press presses False alarm", "False alarm", label)
        record = run.wait_store(lambda r: r.get("confirmFalseAlarm") is True
                                or r.get("current") is None,
                                "one press of False alarm settles in the store",
                                save="store-confirm")
        expect(record.get("confirmFalseAlarm") is True and record.get("current") is not None
               and answer_of(record, ALERT_2) is None,
               "one press of False alarm asks for a second: it stores confirmFalseAlarm, keeps "
               "the alert open and records no answer", "confirmFalseAlarm true, alert 2 open",
               json.dumps({k: record.get(k) for k in ("confirmFalseAlarm", "current")}))
        tree = poll_tree(run, lambda t: (button(t, "false-alarm") or {"props": {}})["props"]
                         .get("label") == "Confirm false alarm",
                         "one press of False alarm relabels its Button 'Confirm false alarm'",
                         "Confirm false alarm", save="false-alarm-confirm")
        expect(card_shows(tree, ALERT_2), "the card stays after one press of False alarm",
               ALERT_2["alert"], brief(tree))
        label = run.press("Confirm false alarm", "press finds the Confirm false alarm Button")
        expect(label == "Confirm false alarm", "the second press presses Confirm false alarm",
               "Confirm false alarm", label)
        record = run.wait_store(lambda r: answer_of(r, ALERT_2) is not None,
                                "the second press answers alert 2", save="store-intended")
        expect(answer_of(record, ALERT_2) == "intended",
               "the second press records the false alarm ('intended')", "intended",
               answer_of(record, ALERT_2))
        card_gone(run, "after Confirm false alarm the tree is empty (the card closes)",
                  "false-alarm-closed")
        script_turn(run, PROMPT_3, AGENT_3, haiku="none", check="verdict: none")
        mark, _ = person_turn(run, PROMPT_3, AGENT_3, "turn-3")
        check = next(r for r in run.requests() if r["seq"] > mark and is_check(r))
        told = section(check["last_user"], ALERTS_HEADING, HOW_HEADING)
        line = (f'2. invariant 1: {ALERT_2["alert"]} Evidence: {quoted_sentence(ALERT_2["evidence"])} '
                f"The person's answer: {INTENDED}.")
        expect(line in told, "the next check hears the false alarm", line, told)

        step(f"{next(n)} ✕: the store records 'dismissed' and the tree is empty; press, "
             "focus and keys refuse by name when nothing is drawn")
        alert_turn(run, PROMPT_4, AGENT_4, ALERT_4, "turn-4")
        label = run.press(CLOSE, "press ✕ finds the Button with role dismiss")
        expect(label == CLOSE, "press ✕ presses the close Button", CLOSE, label)
        record = run.wait_store(lambda r: answer_of(r, ALERT_4) is not None,
                                "✕ answers alert 4", save="store-dismissed")
        expect(answer_of(record, ALERT_4) == "dismissed", "✕ records 'dismissed'", "dismissed",
               answer_of(record, ALERT_4))
        card_gone(run, "after ✕ the tree is empty (the card closes)", "dismissed-closed")
        refused(run, ("press", run.dir, "dismiss"),
                "press dismiss fails by name when nothing is drawn",
                "No drawn Button has role dismiss")
        refused(run, ("press", run.dir, "Details"), "press Details fails by name when nothing "
                "is drawn", "No button 'Details' is drawn")
        for command in (("focus", run.dir), ("keys", run.dir, "1")):
            refused(run, command, f"{command[0]} refuses a desktop run and names press",
                    "control press")

        step(f"{next(n)} without CLAUDE_CODE_NOTIFICATIONS_HOST the CLI resolves $.ui.notify to "
             "no-surface and sends no ui_notify frame")
        shown = len(run.store()["alerts"])
        lines = poll(lambda: debug_lines(run, "$.ui.notify (course-keeper)"),
                     lambda v: len(v) >= shown,
                     "the plugin calls $.ui.notify after each alert (the CLI's debug log)",
                     f"{shown} lines, one per stored alert")
        expect(len(lines) == shown and all(x.endswith("no-surface") for x in lines),
               "without CLAUDE_CODE_NOTIFICATIONS_HOST each notification call resolves "
               "no-surface", f"{shown} lines ending no-surface", json.dumps(lines))
        notified = run.messages("ui_notify", save="ui-notify-none")
        expect(not notified, "without CLAUDE_CODE_NOTIFICATIONS_HOST the CLI sends no ui_notify "
               "frame", "none", json.dumps(notified))

        step(f"{next(n)} a new standing instruction: the CLI sends a ui_toast frame with the "
             "notice; an instruction alert's tree reads 'Breaks instruction: “…”'")
        script_turn(run, INSTRUCTION_PROMPT, INSTRUCTION_ANSWER, haiku="- " + INSTRUCTION,
                    check="verdict: none")
        person_turn(run, INSTRUCTION_PROMPT, INSTRUCTION_ANSWER, "turn-instruction")
        run.wait_store(lambda r: r["instructions"] == [INSTRUCTION], "the haiku reply adds the "
                       "instruction", save="store-instruction")
        toasts = poll(lambda: [m for m in run.messages("ui_toast") if INSTRUCTION in m.get("text", "")],
                      bool, "a recorded instruction makes the CLI send a ui_toast frame with the "
                      "notice", notice(INSTRUCTION), timeout=5)
        expect(len(toasts) == 1 and toasts[0]["text"] == notice(INSTRUCTION)
               and toasts[0].get("plugin") == "course-keeper",
               "the ui_toast frame holds the notice text and names the plugin",
               notice(INSTRUCTION), json.dumps(toasts))
        run.messages("ui_toast", save="ui-toast")
        tree = alert_turn(run, PROMPT_I, AGENT_I, ALERT_I, "turn-instruction-alert")
        card_closed_parts(tree, ALERT_I, HEADLINE_I)
        label = run.press("dismiss", "press dismiss finds the Button with role dismiss")
        expect(label == CLOSE, "press dismiss presses the close Button", CLOSE, label)
        record = run.wait_store(lambda r: answer_of(r, ALERT_I) is not None,
                                "✕ answers the instruction alert", save="store-instruction-alert")
        expect(answer_of(record, ALERT_I) == "dismissed", "✕ records 'dismissed' for the "
               "instruction alert", "dismissed", answer_of(record, ALERT_I))
        card_gone(run, "after ✕ the tree is empty (the instruction alert's card closes)",
                  "instruction-alert-closed")
        view = run.command("", "Last check:", "status-instruction")
        want = f"Standing instructions: 1. {INSTRUCTION} Alerts in this session:"
        expect(want in flat(view), "status lists the instruction", want, view)
        view = run.command("forget 1", "Standing instruction 1 removed:", "forget-1")
        expect(has(view, f'Standing instruction 1 removed: "{INSTRUCTION}"'),
               "forget quotes the words", INSTRUCTION, view)
        run.wait_store(lambda r: r["instructions"] == [] and r["withdrawn"] == [INSTRUCTION],
                       "forget withdraws the instruction", save="store-forget")

        step(f"{next(n)} off, check, on")
        run.command("off", "Course Keeper checks are off for this session.", "off",
                    what="off answers that checks are off")
        run.wait_store(lambda r: r["isOff"] is True, "off stores isOff", save="store-off")
        script_turn(run, PROMPT_5, AGENT_5, haiku="none", check=None)
        mark, record = person_turn(run, PROMPT_5, AGENT_5, "turn-off", checked=False)
        expect(record["lastCheck"]["outcome"] == CHECKS_OFF, "with checks off a turn's check does "
               "not run", CHECKS_OFF, record["lastCheck"]["outcome"])
        checks = [r["seq"] for r in run.requests() if r["seq"] > mark and is_check(r)]
        expect(not checks, "with checks off a turn sends no check request", "none",
               json.dumps(checks))
        run.reply(final(AGENT_5), "verdict: none", times=1)
        mark = run.last_seq()
        view = run.command("check", "Check finished:", "manual-check", timeout=45,
                           what="check runs while checks are off and prints its result")
        expect(has(view, "Check finished: verdict: none."), "check prints its result",
               "Check finished: verdict: none.", view)
        checks = [r for r in run.requests() if r["seq"] > mark and is_check(r)]
        expect(len(checks) == 1 and final(AGENT_5) in checks[0]["last_user"],
               "the manual check sends one check request with the last answer", "1", len(checks))
        run.command("on", "Course Keeper checks are on for this session.", "on",
                    what="on answers that checks are on")
        run.wait_store(lambda r: r["isOff"] is False, "on stores isOff false", save="store-on")

        step(f"{next(n)} a leading system-reminder block does not reach the haiku call")
        script_turn(run, REMINDED_PROMPT, REMINDED_ANSWER, haiku="none", check="verdict: none")
        mark = run.last_seq()
        started = time.time() * 1000
        run.ctl("send", run.dir, REMINDED_PROMPT, "--reminder", REMINDER)
        run.wait("⏺ " + REMINDED_ANSWER, after="❯ " + REMINDED_PROMPT, timeout=45,
                 save="turn-reminder")
        extract = run.wait_request(lambda r: r["seq"] > mark and is_extract(r)
                                   and REMINDED_PROMPT in r["last_user"],
                                   "the reminded prompt starts the haiku call")
        Path(run.evidence, "reminder-extract.json").write_text(json.dumps(extract, indent=2))
        # The block must reach the session, or the assertions below prove nothing.
        run.wait_request(lambda r: r["seq"] > mark and not is_extract(r)
                         and "<system-reminder>\n" + REMINDER in r["last_user"]
                         and REMINDED_PROMPT in r["last_user"],
                         "the main turn holds the reminder block before the person's words")
        held = message_in(extract)
        expect(REMINDER not in extract["last_user"] and "<system-reminder>" not in extract["last_user"],
               "the haiku call does not hold the system-reminder block", "no reminder text",
               json.dumps((held or extract["last_user"])[:300]))
        expect(held is not None and held.strip() == REMINDED_PROMPT,
               "the haiku call's <message> holds the person's words", REMINDED_PROMPT,
               json.dumps(held))
        run.wait_store(ended_after(started), "the reminded turn's check ended")

        step(f"{next(n)} learn, short")
        for i, (prompt, answer) in enumerate((L_FAIL, L_FIX)):
            script_turn(run, prompt, answer, haiku="none", check="verdict: none")
            person_turn(run, prompt, answer, f"learn-turn-{i + 1}")
        run.reply(MARKERS["learn"], learn_draft(SENTENCE, "invariant 1", QUOTE, ACT), times=1)
        view = run.command("learn", "If this is the act: /course-keeper learn yes", "learn",
                           timeout=45, what="learn answers with the act it read")
        for text in ("Course Keeper read this as the act you corrected:", ACT,
                     f"The agent's words: \"{QUOTE}\""):
            expect(has(view, text), f"learn shows {text!r}", text, view)
        expect(not has(view, SENTENCE) and "Never convert" not in view,
               "learn does not show the sentence yet", "no sentence", view)
        run.wait_store(lambda r: (r.get("learn") or {}).get("sentence") == SENTENCE,
                       "the store holds the scripted draft", save="store-draft")
        # The control and verify calls test the corrected turn; every earlier-turn test answers none.
        run.reply("AGENT: " + QUOTE, "verdict: none", times=1, unless=[SENTENCE])
        run.reply("AGENT: " + QUOTE, deviation("invariant 1", L_ALERT, L_INSTEAD, QUOTE, L_NOTE),
                  times=1)
        run.reply(MARKERS["excerpt"], "verdict: none")
        mark = run.last_seq()
        view = run.command("learn yes", CLOSING, "learn-yes", timeout=90,
                           what="learn yes answers with the draft and its tests")
        plugin = json.loads((REPO / ".claude-plugin/plugin.json").read_text())["version"]
        for text in ("Draft sentence for VISION.md, invariant 1:", "  " + SENTENCE,
                     "Test on the turn you corrected: the check alerts with this sentence added.",
                     f"Course Keeper {plugin}."):
            expect(has(view, text), f"learn yes shows {text!r}", text, view)
        expect(re.search(r"Test on \d+ earlier turns? of this session: no new alert\.", flat(view)),
               "learn yes reports the scripted earlier-turn results", "no new alert", view)
        run.wait_store(lambda r: "learn" not in r and r.get("learningSince") is None,
                       "learn yes drops the draft", save="store-learned")
        expect(vision_file.read_bytes() == seed, "VISION.md is unchanged", "unchanged", "changed")

        step(f"{next(n)} the excerpt checks of learn yes hold the reminded prompt as the person's "
             "words, without the reminder, and the reminded turn as a turn of its own")
        # learn yes has answered, so every excerpt request of it is in the log.
        excerpts = [r for r in run.requests() if r["seq"] > mark and is_excerpt(r)]
        Path(run.evidence, "learn-excerpts.json").write_text(json.dumps(excerpts, indent=2))
        parts = [(section(r["last_user"], PERSON_HEADING, LATEST_HEADING),
                  section(r["last_user"], LATEST_HEADING, "\x00")) for r in excerpts]
        expect(parts and all(REMINDER not in person and "system-reminder" not in person
                             for person, _ in parts),
               "no excerpt request holds the reminder under the person's messages",
               "no reminder text", json.dumps([person[-400:] for person, _ in parts]))
        corrected = [person for person, latest in parts if "AGENT: " + QUOTE in latest]
        expect(len(corrected) == 2 and all(REMINDED_PROMPT in person for person in corrected),
               "both excerpt requests of the corrected turn hold the reminded prompt under the "
               "person's messages", REMINDED_PROMPT, json.dumps([p[-400:] for p in corrected]))
        reminded = [(person, latest) for person, latest in parts
                    if "AGENT: " + REMINDED_ANSWER in latest]
        expect(len(reminded) == 1
               and reminded[0][0].rstrip().endswith(REMINDED_PROMPT)
               and reminded[0][1].lstrip().startswith("INPUT: <system-reminder>")
               and "AGENT: " + AGENT_5 not in reminded[0][1],
               "the reminded turn is an earlier turn of its own: its person messages end with "
               "the reminded prompt, and its rows start at that prompt",
               "one request", json.dumps([(p[-200:], l[:400]) for p, l in reminded]))

        step(f"{next(n)} every model request of the main run got a scripted reply")
        run.requests(save="model-requests")
        unscripted(run)

        tight_rows = CARD_ROWS - 1
        step(f"{next(n)} a short band (maxRows {tight_rows}, below CARD_ROWS {CARD_ROWS}): the "
             "tree holds the buttons before the sentence")
        with second_run("--surface", "desktop", "--max-rows", str(tight_rows), *cli,
                        parent=run, label="short-band-run") as short:
            tree = alert_turn(short, PROMPT_1, AGENT_1, ALERT_1, "turn-1")
            order = roles(tree, ALERT_1, HEADLINE_1)
            expect("sentence" in order and "tell" in order
                   and order.index("tell") < order.index("sentence"),
                   f"in a short band (maxRows {tight_rows} < CARD_ROWS {CARD_ROWS}) the buttons "
                   "come right under the headline, before the sentence",
                   "tell before sentence", json.dumps(order))
            card_closed_parts(tree, ALERT_1, HEADLINE_1, tight=True)
            props = render_props(short)
            expect(props and props["maxRows"] == tight_rows,
                   f"the host rendered with maxRows {tight_rows}", tight_rows, json.dumps(props))
            short.screen(visible=True, save="card-short-band-text")
            unscripted(short)

        step(f"{next(n)} with CLAUDE_CODE_NOTIFICATIONS_HOST=1 at bodyColumns 1 (the app's first "
             "measure): the CLI sends one ui_notify frame and the tree holds every Button")
        with second_run("--surface", "desktop", "--notifications-host", "--columns", "1", *cli,
                        parent=run, label="notify-run") as other:
            tree = alert_turn(other, PROMPT_1, AGENT_1, ALERT_1, "turn-1")
            notes = poll(lambda: other.messages("ui_notify"), bool,
                         "with CLAUDE_CODE_NOTIFICATIONS_HOST=1 an alert makes the CLI send a "
                         "ui_notify frame", "one ui_notify frame")
            other.messages("ui_notify", save="ui-notify")
            expect(len(notes) == 1 and notes[0].get("title") == TITLE_1
                   and notes[0].get("text") == ALERT_1["alert"],
                   "the ui_notify frame holds the title and the alert sentence",
                   f"title {TITLE_1!r}, text {ALERT_1['alert']!r}", json.dumps(notes))
            sent = poll(lambda: debug_lines(other, "$.ui.notify (course-keeper)"), bool,
                        "the CLI's debug log records the notification call", "a line")
            expect(all(x.endswith("sent by client") for x in sent),
                   "with the variable set the CLI resolves the call 'sent by client'",
                   "sent by client", json.dumps(sent))
            props = render_props(other)
            expect(props and props["bodyColumns"] == 1 and props["maxRows"] == APP_MAX_ROWS,
                   "the host rendered with bodyColumns 1 and maxRows 12", "1, 12",
                   json.dumps(props))
            card_closed_parts(tree, ALERT_1, HEADLINE_1)
            drawn = sorted(shown_text(b) for b in buttons(tree) if has_handle(b))
            want = sorted([CLOSE, "Tell the agent", "Details", "False alarm"])
            expect(drawn == want, "at bodyColumns 1 the tree holds every Button with a press "
                   "handle", json.dumps(want, ensure_ascii=False),
                   json.dumps(drawn, ensure_ascii=False))
            other.screen(visible=True, save="card-columns-1-text")
            unscripted(other)

    return desktop


def main():
    parser = argparse.ArgumentParser(
        prog="journeys/desktop", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--cli", metavar="PATH",
                        help="the CLI for every run (default: the desktop app's pinned build)")
    a = parser.parse_args()
    cli = ("--cli", a.cli) if a.cli else ()
    print("note: every desktop run here is a stand-in: the harness plays the desktop app's role "
          "for the app's own Claude Code. A PASS covers the tree and the frames that this CLI "
          "returns. It does not cover how the desktop app paints the card, its notifications "
          "or its keyboard handling.", flush=True)
    journey(make_journey(cli), "--surface", "desktop", "--attach-later", *cli)


if __name__ == "__main__":
    main()
