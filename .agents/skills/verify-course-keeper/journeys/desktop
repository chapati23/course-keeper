# ---------------------------------------------------------------- the tree

def kids(node):
    props = node.get("props") or {}
    ch = props.get("children", node.get("children"))
    if ch is None:
        return []
    return ch if isinstance(ch, list) else [ch]


def inline(node):
    """The text of a node with its nested Texts."""
    if isinstance(node, (str, int, float)) and not isinstance(node, bool):
        return str(node)
    if isinstance(node, list):
        return "".join(inline(x) for x in node)
    return "".join(inline(x) for x in kids(node)) if isinstance(node, dict) else ""


def is_drawn(tree):
    return isinstance(tree, dict) and tree.get("type") not in (None, "engine")


def elements(tree):
    """The drawn elements in tree order: Svg, Button and Text (a Text with its nested Texts is
    one element). A Box is walked, not listed."""
    out = []

    def walk(node):
        if isinstance(node, list):
            for x in node:
                walk(x)
            return
        if not isinstance(node, dict):
            if node not in (None, "", False, True):
                out.append({"type": "string", "props": {}, "text": str(node)})
            return
        kind = node.get("type")
        if kind == "Box":
            for x in kids(node):
                walk(x)
        else:
            out.append({"type": kind, "props": node.get("props") or {}, "press": node.get("press"),
                        "text": inline(node)})

    if is_drawn(tree):
        walk(tree)
    return out


def buttons(tree):
    return [e for e in elements(tree) if e["type"] == "Button"]


def button(tree, key):
    hit = [e for e in buttons(tree) if e["props"].get("key") == key]
    return hit[0] if len(hit) == 1 else None


def shown_text(e):
    """What a Button draws: its label, or its text when it has no label."""
    label = e["props"].get("label")
    return str(label) if label is not None else e["text"]


def has_handle(e):
    press = e.get("press") or {}
    return press.get("plugin") == "course-keeper" and isinstance(press.get("handle"), int)


def roles(tree, a, headline):
    """Each drawn element named by its part of the card, in tree order."""
    names = {headline: "headline", a["alert"]: "sentence", "Course Keeper": "brand"}
    out = []
    for e in elements(tree):
        if e["type"] == "Svg":
            out.append("wheel")
        elif e["type"] == "Button":
            out.append(e["props"].get("key") or "button:" + shown_text(e))
        elif e["text"] in names:
            out.append(names[e["text"]])
        elif e["text"].startswith("Instead: "):
            out.append("instead")
        elif e["text"].startswith("Agent wrote: "):
            out.append("quote")
        elif e["text"].startswith("For the agent: "):
            out.append("note")
        else:
            out.append("text: " + e["text"][:60])
    return out


def brief(tree):
    return json.dumps([{k: v for k, v in e.items() if k != "props" or v} for e in elements(tree)]
                      if is_drawn(tree) else tree, ensure_ascii=False)[:3000]


def card_shows(tree, a):
    """True when the tree draws the card of alert a (its sentence)."""
    return any(e["type"] == "Text" and e["text"] == a["alert"] for e in elements(tree))


def poll_tree(run, ok, what, expected, timeout=10, save=None):
    """Polls `control screen --tree` until ok(tree); a timeout fails on the promise `what`."""
    deadline = time.monotonic() + timeout
    while True:
        tree = run.tree()
        if ok(tree):
            if save:
                run.tree(save=save)
            return tree
        if time.monotonic() >= deadline:
            run.tree(save=(save or "tree") + "-timeout")
            raise JourneyFailure(what, expected, brief(tree))
        time.sleep(0.2)


def card_closed_parts(tree, a, headline, tight=False):
    """The card's parts while Details is closed, each as a named assertion on the tree."""
    expect(tree.get("type") == "Box", "the card is one Box", "a root Box", brief(tree))
    els = elements(tree)
    wheel = [e for e in els if e["type"] == "Svg"]
    expect(len(wheel) == 1 and wheel[0]["props"].get("alt") == "Course Keeper"
           and str(wheel[0]["props"].get("source", "")).startswith("<svg"),
           "the card shows the Course Keeper wheel (one Svg, alt 'Course Keeper')",
           "one Svg with alt 'Course Keeper' and an <svg> source", brief(tree))
    head = [e for e in els if e["type"] == "Text" and e["text"] == headline]
    expect(len(head) == 1 and head[0]["props"].get("weight") == "semibold",
           f"one strong line names what the session breaks: {headline!r} (weight semibold)",
           headline + ", weight semibold", brief(tree))
    close = button(tree, "dismiss")
    expect(close is not None and close["props"].get("role") == "dismiss"
           and shown_text(close) == CLOSE and close["props"].get("label") in (None, CLOSE)
           and has_handle(close),
           "the close Button has role dismiss, draws the mark ✕ and no word, and carries a "
           "press handle", f"Button key dismiss, role dismiss, text {CLOSE!r}, label none or "
           f"{CLOSE!r}, press handle", brief(tree))
    sentence = [e for e in els if e["type"] == "Text" and e["text"] == a["alert"]]
    expect(len(sentence) == 1 and sentence[0]["props"].get("maxLines") == 3,
           "closed, the tree limits the one sentence to three lines (maxLines 3)",
           a["alert"] + " with maxLines 3", brief(tree))
    for key, label, variant in (("tell", "Tell the agent", "primary"), ("details", "Details", None),
                                ("false-alarm", "False alarm", None)):
        b = button(tree, key)
        expect(b is not None and b["props"].get("label") == label
               and b["props"].get("variant") == variant and has_handle(b),
               f"the card's Button {label!r} is drawn with a press handle"
               + (f" (variant {variant})" if variant else ""),
               f"one Button key {key!r}, label {label!r}, variant {variant}, press handle",
               brief(tree))
    brand = [e for e in els if e["type"] == "Text" and e["text"] == "Course Keeper"]
    expect(len(brand) == 1 and brand[0]["props"].get("size") == "caption",
           "the plugin's name is small (size caption)", "one Text 'Course Keeper', size caption",
           brief(tree))
    keyed = [(shown_text(b), b["props"]["hotkey"]) for b in buttons(tree)
             if b["props"].get("hotkey") is not None]
    expect(not keyed, "no Button carries a number key (no hotkey)", "none", json.dumps(keyed))
    focused = [shown_text(b) for b in buttons(tree) if b["props"].get("autoFocus")]
    expect(not focused, "no Button takes the focus first (no autoFocus)", "none",
           json.dumps(focused))
    every = " ".join(e["text"] for e in els)
    expect("ctrl+x tab" not in every, "the card shows no terminal key hint ('ctrl+x tab')",
           "no 'ctrl+x tab'", every)
    expect("─" not in every, "the tree holds no character rule of the terminal frame (no '─')",
           "no '─'", every)
    for part in ("Instead: ", "Agent wrote: ", "For the agent: "):
        expect(not any(e["text"].startswith(part) for e in els),
               f"closed, the card holds no {part.strip()!r} part", "none", brief(tree))
    order = roles(tree, a, headline)
    middle = (["dismiss", "tell", "details", "false-alarm", "brand", "sentence"] if tight
              else ["dismiss", "sentence", "tell", "details", "false-alarm", "brand"])
    want = ["wheel", "headline"] + middle
    expect(order == want,
           "the wheel, the headline and ✕ come first; "
           + ("the buttons come before the sentence (a short band)" if tight
              else "then the sentence; then the buttons, with the plugin's name at their end"),
           json.dumps(want), json.dumps(order))
    return els


# ---------------------------------------------------------------- run plumbing

def frames(run):
    path = Path(run.evidence, "frames.jsonl")
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def render_props(run):
    """The props of the newest ui_render request that the host sent."""
    sent = [f["frame"]["request"] for f in frames(run) if f["dir"] == "host->cli"
            and (f["frame"].get("request") or {}).get("subtype") == "ui_render"]
    return sent[-1]["props"] if sent else None


def debug_lines(run, needle):
    path = Path(run.evidence, "cli-debug.log")
    text = path.read_text(errors="replace") if path.exists() else ""
    return [line.strip() for line in text.splitlines() if needle in line]


def poll(read, ok, what, expected, timeout=10):
    """Polls read() until ok(value); a timeout fails on the promise `what`."""
    deadline = time.monotonic() + timeout
    while True:
        value = read()
        if ok(value):
            return value
        if time.monotonic() >= deadline:
            raise JourneyFailure(what, expected, json.dumps(value)[:3000])
        time.sleep(0.2)


def ended_after(started):
    def matches(record):
        last = record.get("lastCheck") or {}
        return last.get("at", 0) >= started and record.get("checkingSince") is None
    return matches


def person_turn(run, prompt, answer, label, checked=True, extract=True, first_prompt=False):
    """A person's turn in the app's envelope: the answer shows, the store has a person, the
    haiku call holds the prompt, and the turn's check ends. With checked, the check ran: it
    did not stop at "no surface is attached", and a check request carries the answer.
    Returns (mark, record)."""
    mark, started = run.last_seq(), time.time() * 1000
    ask(run, prompt, answer, label)
    # Only a run whose first person prompt is this one proves the promise: elsewhere the
    # doctor's /course-keeper or an earlier turn already marked the session.
    run.wait_store(lambda r: r.get("hasPerson") is True,
                   "a desktop person counts: a prompt in the app's envelope marks the session "
                   "as having a person (hasPerson)" if first_prompt else
                   "the session has a person (hasPerson, set by this or an earlier prompt)",
                   save="store-person-" + label)
    if extract:
        run.wait_request(lambda r: r["seq"] > mark and is_extract(r) and message_in(r) == prompt,
                         "a desktop person counts: the prompt starts the haiku call")
    record = run.wait_store(ended_after(started), f"the check of {label} ended",
                            save="store-" + label)
    if checked:
        outcome = record["lastCheck"]["outcome"]
        expect(outcome != NO_SURFACE, "an attached desktop surface lets a person's turn's check "
               "run", "an outcome other than " + repr(NO_SURFACE), outcome)
        run.wait_request(lambda r: r["seq"] > mark and is_check(r) and final(answer) in r["last_user"],
                         f"the check request of {label}")
    return mark, record


def alert_turn(run, prompt, answer, a, label):
    """A person's turn whose check finds alert a: the store holds a as the current alert,
    then the tree draws its card. Returns the tree."""
    script_turn(run, prompt, answer, haiku="none", check=deviation(**a))
    person_turn(run, prompt, answer, label)
    run.wait_store(lambda r: (r.get("current") or {}).get("evidence") == a["evidence"],
                   "the check's deviation is the stored current alert", save="store-current-" + label)
    return poll_tree(run, lambda t: card_shows(t, a),
                     "the stored alert is drawn as a card: the tree that the CLI returns for "
                     "ui_render on the desktop surface holds its sentence",
                     a["alert"], save="card-" + label)


def card_gone(run, what, label):
    return poll_tree(run, lambda t: not is_drawn(t), what, "no tree (the CLI draws nothing)",
                     save=label)


def answer_of(record, a):
    return next((x["answer"] for x in record.get("alerts") or [] if x["evidence"] == a["evidence"]),
                None)


def refused(run, args, what, needle):
    result = run.ctl(*args, check=False)
    expect(result.returncode == 1 and needle in result.stderr, what, f"exit 1 and {needle!r}",
           f"exit {result.returncode}: {(result.stdout + result.stderr).strip()}")
    return result.stderr.strip()


# ---------------------------------------------------------------- the journey

def make_journey(cli):
    def desktop(run):
        vision_file = Path(run.dir, "scratch/project/VISION.md")
        seed = vision_file.read_bytes()
        n = iter(range(1, 100))

        report = Path(run.evidence, "doctor-report.txt").read_text()
        line = next((x for x in report.splitlines() if x.startswith("ok   version:")), "")
        # doctor writes "the desktop app's pinned build: PATH" or "another binary, not the desktop
        # app's pinned build: PATH".
        pinned = "; the desktop app's pinned build: " in line
        step(f"{next(n)} the plugin loads under "
             + ("the desktop app's pinned CLI" if pinned
                else "the CLI given by --cli, not the desktop app's pinned build"))
        spawn = json.loads(Path(run.evidence, "spawn.json").read_text())
        init = json.loads(Path(run.evidence, "initialize.json").read_text())
        version = init["response"]["claude_code_version"]
        path = spawn["argv"][0]
        expect(version in line and path in line, "doctor names the CLI's version and path",
               f"{version} and {path}", line)
        expect(not cli or path == os.path.abspath(os.path.expanduser(cli[1])),
               "the run ran the CLI that --cli names", cli, path)
        expect("not attached yet" in report, "doctor accepts a run that is not attached yet",
               "surfaces: not attached yet", report)
        kind = "the desktop app's pinned build" if pinned else "another binary (--cli)"
        Path(run.evidence, "cli.txt").write_text(f"version {version}\npath {path}\n{kind}\n")
        print(f"CLI {version} at {path} ({kind})", flush=True)

        step(f"{next(n)} a frame in the app's envelope (client_platform desktop_app) counts as a "
             "person's; a frame without client_platform does not")
        with second_run("--surface", "desktop", *cli, parent=run, label="person-run",
                        doctor=False) as fresh:
            script_turn(fresh, BARE_PROMPT, BARE_ANSWER, haiku="none", check="verdict: none")
            fresh.ctl("send", fresh.dir, BARE_PROMPT, "--bare")
            fresh.wait("⏺ " + BARE_ANSWER, after="❯ " + BARE_PROMPT, save="bare-turn")
            record = fresh.store(save="store-after-bare")
            expect(not (record or {}).get("hasPerson"), "a frame without client_platform is no "
                   "person: nothing is recorded", "no record, or hasPerson false",
                   json.dumps(record))
            mark = fresh.last_seq()
            script_turn(fresh, REAL_PROMPT, REAL_ANSWER, haiku="none", check="verdict: none")
            person_turn(fresh, REAL_PROMPT, REAL_ANSWER, "real-turn", first_prompt=True)
            late = [(r["seq"], r["model"], r["matched"]) for r in fresh.requests()
                    if is_messages(r) and ((is_extract(r) and message_in(r) == BARE_PROMPT)
                                           or (is_check(r) and final(BARE_ANSWER) in r["last_user"]))]
            expect(not late, "a frame without client_platform starts no haiku call and no check",
                   "none", json.dumps(late))
            bare_main = [r["seq"] for r in fresh.requests() if r["seq"] <= mark and is_main(r)]
            expect(len(bare_main) == 1, "the bare frame's turn ran (one main request)", "1",
                   json.dumps(bare_main))
            unscripted(fresh)

        step(f"{next(n)} before ui_attach a person's turn records 'no surface is attached'; "
             "ui_attach answers surfaces [\"desktop\"]")
        view = run.screen()
        expect("(not attached" in view, "the host has not attached", "(not attached ...)", view)
        script_turn(run, P0, A0, haiku="none", check=None)
        mark, record = person_turn(run, P0, A0, "turn-0", checked=False)
        expect(record["lastCheck"]["outcome"] == NO_SURFACE,
               "before ui_attach, a person's turn records 'did not run: no surface is attached'",
               NO_SURFACE, json.dumps(record["lastCheck"]))
        checks = [r["seq"] for r in run.requests() if r["seq"] > mark and is_check(r)]
        expect(not checks, "before ui_attach, a person's turn sends no check request", "none",
               json.dumps(checks))
        surfaces = run.attach()
        expect(surfaces == 'surfaces: ["desktop"]', "ui_attach answers the desktop surface",
               'surfaces: ["desktop"]', surfaces)
        run.expect_wait("(nothing drawn)", "after ui_attach the host renders AbovePrompt and the "
                        "CLI draws nothing while no alert is open", visible=True, timeout=10,
                        save="attached")

        step(f"{next(n)} the tree that the CLI returns for ui_render at maxRows {APP_MAX_ROWS} "
             "holds the card's parts")
        tree = alert_turn(run, PROMPT_1, AGENT_1, ALERT_1, "turn-1")
        card_closed_parts(tree, ALERT_1, HEADLINE_1)
        props = render_props(run)
        expect(props and props["maxRows"] == APP_MAX_ROWS and props["bodyColumns"] == 96,
               "the host rendered with maxRows 12 (the app's) and bodyColumns 96 (set by the "
               "harness)", "maxRows 12, bodyColumns 96", json.dumps(props))
        record = run.store(save="store-1")
        expect((record["current"] or {}).get("title") == RULE_1 and not record.get("showDetails")
               and record["lastCheck"]["outcome"] == "verdict: deviation (invariant 1)",
               "the store holds alert 1 with its rule's title, Details closed",
               f"current.title {RULE_1!r}, showDetails false, outcome deviation (invariant 1)",
               json.dumps({k: record.get(k) for k in ("current", "showDetails", "lastCheck")}))
        view = run.screen(visible=True, save="card-turn-1-text")
        for text in ("⟨svg: Course Keeper⟩", HEADLINE_1,
                     f"[ {CLOSE} ]  ⟨role dismiss⟩",
                     ALERT_1["alert"] + "  ⟨maxLines 3:",
                     "[ Tell the agent ]  ⟨variant primary⟩", "[ Details ]",
                     "[ False alarm ]", "Course Keeper"):
            expect(text in view, f"control screen renders the tree's part {text!r}", text, view)
        refusal = refused(run, ("press", run.dir, "1"),
                          "press 1 fails by name while the card is drawn: no Button carries "
                          "hotkey 1", "No drawn Button carries hotkey '1'")
        expect("[ Tell the agent ]" in refusal, "the refusal lists the drawn buttons",
