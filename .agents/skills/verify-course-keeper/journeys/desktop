        texts = [e["text"] for e in elements(tree)]
        for text in ("Instead: " + ALERT_1["instead"], f"Agent wrote: {LQ}{QUOTE_1}{RQ}", note):
            expect(text in texts, f"Details shows {text!r} (the quote in curly quotes, without "
                   "Markdown marks)", text, json.dumps(texts, ensure_ascii=False))
        sentence = next(e for e in elements(tree) if e["text"] == ALERT_1["alert"])
